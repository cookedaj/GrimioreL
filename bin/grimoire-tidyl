#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# TidyL is now part of VaultL; kept because the auto-tidy timer calls it:
#   grimoire-tidyl                                          open VaultL
#   grimoire-tidyl run|preview|undo|enable|disable|status   same as grimoire-vaultl tidy <cmd>
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
[ $# -eq 0 ] && exec python3 -m grimoire.spells.vaultl
exec python3 -m grimoire.spells.vaultl tidy "$1"
