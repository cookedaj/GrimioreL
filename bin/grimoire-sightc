#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# SightsL: grimoire-sightc opens its window; grimoire-sightc on|off|toggle|next|status controls the overlay
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
[ $# -eq 0 ] && exec python3 -m grimoire.standalone sightc
exec python3 -m grimoire.spells.sightc.overlay "$1"
