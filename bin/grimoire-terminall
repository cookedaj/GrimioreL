#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# TerminalL, Grimoire's terminal: grimoire-terminall [folder]   (opens a tab in that folder, else the current one)
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m grimoire.spells.terminall "$@"
