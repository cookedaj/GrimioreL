#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# TerminalL, Grimoire's terminal: grimoire-terminall [folder]   (opens a tab in that folder, else the current one)
#   grimoire-terminall -e COMMAND [folder]   runs COMMAND in the new tab
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
exec python3 -m grimoire.spells.terminall "$@"
