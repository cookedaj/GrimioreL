#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# VaultL, Grimoire's file manager with tidying built in:
#   grimoire-vaultl [folder]                                      open a window
#   grimoire-vaultl tidy run|preview|undo|enable|disable|status   auto-tidy from the terminal (and the timer)
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
exec python3 -m grimoire.spells.vaultl "$@"
