#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Byte-compile the app once (users can't write __pycache__ under /usr/share) and refresh the menu and icon caches.
set -e
if [ "$1" = configure ]; then
    python3 -m compileall -q /usr/share/grimoire-linux/grimoire >/dev/null 2>&1 || true
    if command -v update-desktop-database >/dev/null; then update-desktop-database -q /usr/share/applications || true; fi
    if command -v gtk-update-icon-cache >/dev/null; then gtk-update-icon-cache -q /usr/share/icons/hicolor || true; fi
fi
exit 0
